# AnimeX docker-compose configuration.
# DO NOT COMMIT — already covered by .gitignore. chmod 600 recommended.
# After editing this file, re-run: docker compose up -d
#
# Values shown are sensible defaults. Anything not set here falls back to the
# default in compose.yml (the ${VAR:-default} syntax).

# --- REQUIRED: passwords ---
# First boot creates MySQL with these credentials. Changing them later does
# NOT update the existing DB user — you'd need to ALTER USER inside mysql
# or wipe ${MYSQL_DATA_DIR} and let it re-init.
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
ADMIN_PASSWORD=password

# --- Identity ---
ADMIN_USERNAME=admin
MYSQL_DATABASE=animex
MYSQL_USER=animex

# --- Host network bindings ---
# Animex Web UI — the only port that's normally public.
ANIMEX_BIND_ADDR=0.0.0.0
ANIMEX_HOST_PORT=8080
# MySQL & Redis — loopback-only by default for safety. Flip BIND_ADDR to
# 0.0.0.0 (or your LAN IP) to expose externally.
MYSQL_BIND_ADDR=127.0.0.1
MYSQL_HOST_PORT=3306
REDIS_BIND_ADDR=127.0.0.1
REDIS_HOST_PORT=6379

# --- Host bind-mount roots ---
# Where Docker persists per-service state on the host. Relative paths are
# resolved against the directory containing compose.yml.
ANIMEX_DATA_DIR=./docker-data/animex
MYSQL_DATA_DIR=./docker-data/mysql
REDIS_DATA_DIR=./docker-data/redis

# --- Misc ---
TZ=Asia/Shanghai
# Initial storage backend. The admin UI can override this at runtime, but
# this value wins on the first install. Choices: local / pikpak / drive115 / nas.
ANIMEX_STORAGE_PROVIDER=pikpak
# Tag for the image built from ./Dockerfile.
ANIMEX_IMAGE_TAG=animex:local
